# نمونهٔ پیکربندی — مقادیرِ واقعی را در .env بگذار (هیچ‌وقت کامیت نشود)
PORT=8090
DATABASE_URL=postgres://cafenet:STRONG_PASSWORD@127.0.0.1:5432/cafenet

# کلیدِ HMACِ توکن‌ها — تولیدِ پیشنهادی: openssl rand -hex 32
JWT_SECRET=

# کلیدِ RSA عمومیِ پنلِ توسعه‌دهندهٔ مایکت (Base64 — عمومی است ولی برای تأییدِ امضای خرید الزامی)
# بدونِ این مقدار، /purchases/verify همهٔ خریدها را با 503 رد می‌کند (امن به‌صورتِ پیش‌فرض)
IAB_PUBLIC_KEY=

SESSION_TTL_DAYS=30
